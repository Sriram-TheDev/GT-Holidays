# Environment variables — NEVER commit secrets
# Vite loads: .env → .env.local → .env.[mode] → .env.[mode].local
# Use .env.local for real secrets (it's gitignored by the *.local pattern AND explicitly below)
.env
.env.local
.env.*.local
.env.*
functions/.env
functions/.env.*
!.env.example

