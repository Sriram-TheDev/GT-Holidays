# ── Voyage India — Environment Variables Template ────────────────────────────
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored by Vite's default .gitignore pattern (*.local).
# NEVER commit .env.local or any file containing real secrets.

# ── Firebase ─────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Google Maps (JavaScript API) ─────────────────────────────────────────────
# Restrict this key in Google Cloud Console:
#   Application restrictions → HTTP referrers (your production domain)
#   API restrictions → Maps JavaScript API, Places API only
VITE_GOOGLE_MAPS_API_KEY=

# ── Razorpay (public Key ID only — secret lives in functions/.env) ────────────
VITE_RAZORPAY_KEY_ID=
