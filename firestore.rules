rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Packages — public read, no client writes
    match /packages/{packageId} {
      allow read: if true;
      allow write: if false;
    }

    // Promo codes — public read, no client writes
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if false;
    }

    // Users — authenticated owner only
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Bookings — auth required; client can only create pending; updates via Admin SDK only
    match /bookings/{bookingId} {
      allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid
                   && request.resource.data.status == "pending";
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;   // Cloud Functions (Admin SDK) only
      allow delete: if false;
    }
  }
}
